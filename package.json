{
  "name": "wjscli",
  "version": "0.2.0",
  "description": "Wiki.js v2 CLI and MCP server that authenticates as a real human user via their JWT.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wjscli": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(m=>m.promises.chmod('dist/index.js',0o755))\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
